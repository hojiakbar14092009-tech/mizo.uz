DATABASE_URL="file:./mizo.db"
JWT_SECRET="mizo-super-secret-key-change-in-production"
NEXTAUTH_URL="http://localhost:3000"

# AI (optional). Without a key the AI routes answer with built-in rule-based advice.
# Get a key at https://console.anthropic.com
ANTHROPIC_API_KEY=""
# Default model is claude-opus-5-5. For a cheaper free-trial setup use claude-haiku-5-5.
ANTHROPIC_MODEL="claude-opus-5-5"

# SMS: "mock" logs messages to the SmsLog table instead of sending them.
SMS_PROVIDER="mock"
